{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Copilot-home/DAIOF-Framework/blob/main/governance/github_ecosystem_manifest.schema.json",
  "title": "Copilot-home GitHub Ecosystem Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "org",
    "generated_at",
    "source_of_truth",
    "policy",
    "repositories"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "./github_ecosystem_manifest.schema.json"
    },
    "schema_version": {
      "type": "string",
      "const": "1.1.0"
    },
    "org": {
      "type": "string",
      "const": "Copilot-home"
    },
    "generated_at": {
      "type": "string",
      "format": "date"
    },
    "source_of_truth": {
      "type": "string",
      "const": "github:Copilot-home/DAIOF-Framework"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mutation_mode",
        "ci_authority_rule",
        "secret_policy",
        "public_path_policy",
        "default_branch_rule"
      ],
      "properties": {
        "mutation_mode": {
          "type": "string",
          "const": "pull-request-only"
        },
        "ci_authority_rule": {
          "type": "string",
          "const": "exactly-one-authoritative-gate-per-active-repository"
        },
        "secret_policy": {
          "type": "string",
          "const": "no-secrets-in-repository"
        },
        "public_path_policy": {
          "type": "string",
          "const": "no-absolute-local-paths-in-public-artifacts"
        },
        "default_branch_rule": {
          "type": "string",
          "const": "main-unless-upstream-or-migration-exception-is-documented"
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repository"
      }
    }
  },
  "$defs": {
    "defaultBranchException": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "rationale",
        "exit_criteria",
        "rollback"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "exit_criteria": {
          "type": "string",
          "minLength": 1
        },
        "rollback": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "visibility",
        "size_kb",
        "default_branch",
        "namespace",
        "role",
        "lifecycle",
        "ci_authority",
        "ci_secondary",
        "local_first",
        "local_artifacts_allowed",
        "secret_policy",
        "quota_criticality",
        "normalization_flags",
        "evidence_status",
        "last_verified_at"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "private",
            "internal"
          ]
        },
        "size_kb": {
          "type": "integer",
          "minimum": 0
        },
        "default_branch": {
          "type": "string",
          "minLength": 1
        },
        "default_branch_exception": {
          "$ref": "#/$defs/defaultBranchException"
        },
        "namespace": {
          "type": "string",
          "enum": [
            "core",
            "runtime",
            "tooling",
            "workbench",
            "product",
            "experiment",
            "reference",
            "archive"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "active",
            "incubating",
            "maintenance",
            "needs-normalization",
            "archive-candidate",
            "empty"
          ]
        },
        "ci_authority": {
          "type": "string",
          "enum": [
            "local-verifier",
            "github-actions",
            "circleci",
            "upstream",
            "none",
            "undetermined"
          ]
        },
        "ci_secondary": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "local_first": {
          "type": "boolean"
        },
        "local_artifacts_allowed": {
          "type": "boolean"
        },
        "secret_policy": {
          "type": "string",
          "const": "no-secrets-in-repository"
        },
        "quota_criticality": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "normalization_flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evidence_status": {
          "type": "string",
          "enum": [
            "verified-by-github-connector",
            "partial",
            "missing"
          ]
        },
        "last_verified_at": {
          "type": "string",
          "format": "date"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "default_branch": {
                "not": {
                  "const": "main"
                }
              }
            },
            "required": [
              "default_branch"
            ]
          },
          "then": {
            "required": [
              "default_branch_exception"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "lifecycle": {
                "const": "active"
              }
            },
            "required": [
              "lifecycle"
            ]
          },
          "then": {
            "properties": {
              "ci_authority": {
                "not": {
                  "enum": [
                    "none",
                    "undetermined"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "visibility": {
                "const": "public"
              }
            },
            "required": [
              "visibility"
            ]
          },
          "then": {
            "properties": {
              "local_artifacts_allowed": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "lifecycle": {
                "const": "empty"
              }
            },
            "required": [
              "lifecycle"
            ]
          },
          "then": {
            "properties": {
              "size_kb": {
                "const": 0
              },
              "ci_authority": {
                "const": "none"
              }
            }
          }
        }
      ]
    }
  }
}
